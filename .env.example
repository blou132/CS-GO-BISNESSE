# Copier en .env. Usage local uniquement. Aucune vraie clé dans ce fichier.
# Choisir un mot de passe local URL-safe (lettres, chiffres, tirets).
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_DB=cs2
POSTGRES_USER=cs2
# Lancement natif ; Compose fournit sa propre URL vers le service db.
DATABASE_URL=postgresql+psycopg://cs2:replace-with-local-password@127.0.0.1:5432/cs2
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SYNC_TTL_SECONDS=300
STALE_AFTER_SECONDS=3600
VERY_STALE_AFTER_SECONDS=86400
PRICE_OBSERVATION_MIN_INTERVAL_SECONDS=3600
MAX_LISTINGS=500
HISTORY_RETENTION_DAYS=30

# Monitoring continu 24/7. Désactivé par défaut : aucune requête marché
# périodique ne part tant que MARKET_SYNC_ENABLED ne vaut pas true.
MARKET_SYNC_ENABLED=false
MARKET_SYNC_QUERY=
CSFLOAT_SYNC_INTERVAL_SECONDS=900
SKINPORT_SYNC_INTERVAL_SECONDS=900
DMARKET_SYNC_INTERVAL_SECONDS=900

# Flux officiel optionnel. Ne pas activer sans validation live du contrat prix.
SKINPORT_REALTIME_ENABLED=false
SKINPORT_REALTIME_QUEUE_SIZE=256
SKINPORT_REALTIME_PRICE_UNIT=unverified
SKINPORT_REALTIME_PRICE_UNIT_SOURCE=
SKINPORT_REALTIME_STALE_SECONDS=300
FLOAT_MIN_SAMPLES=5

# Côté serveur uniquement. Consulter docs/integrations/ avant activation.
CSFLOAT_API_KEY=
DMARKET_PUBLIC_KEY=
DMARKET_SECRET_KEY=

# Référence facultative : EUR pour 1 USD. Ne jamais inventer un taux.
# Fournir les trois champs ensemble avec source et date ISO 8601 avec fuseau.
# Un taux de référence ne représente pas le coût effectif d'une conversion.
FX_USD_EUR_RATE=
FX_RATE_SOURCE=
FX_RATE_TIMESTAMP=
FX_MAX_AGE_HOURS=120
# Collecte read-only du dernier taux BCE. Désactivée par défaut.
FX_REFERENCE_SYNC_ENABLED=false
FX_REFERENCE_SYNC_INTERVAL_SECONDS=21600

# Next.js uniquement, jamais NEXT_PUBLIC_* pour les secrets.
API_BASE_URL=http://127.0.0.1:8000

# Accès administrateur privé. Générer le hash avec
# ./scripts/generate-admin-password-hash.py et conserver les quotes simples.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=''
SESSION_SECRET=
SESSION_COOKIE_SECURE=false
SESSION_TTL_SECONDS=28800
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900

# Production Docker Linux. Copier ce fichier vers .env.production, puis
# définir ENVIRONMENT=production. Les ports restent privés par défaut.
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=3000
DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILES=5
BACKUP_DIR=./backups/postgres
BACKUP_RETENTION_DAYS=14
DEPLOY_WAIT_SECONDS=120
HEALTHCHECK_URL=http://127.0.0.1:3000/api/health
